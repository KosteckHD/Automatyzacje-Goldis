# Lokalny wariant Windows: PostgreSQL i Redis uruchom osobno w Docker Compose.
# Wartości poniżej są wyłącznie przykładowe. Nie używaj ich dla rzeczywistych danych.
APP_ENV=development
GOLDIS_SECRETS_DIR=C:/Users/YourUser/AppData/Local/Goldis/secrets
DATABASE_URL=postgres://goldis_api:CHANGE_ME@127.0.0.1:55432/goldis
MIGRATOR_DATABASE_URL=postgres://goldis_migrator:CHANGE_ME@127.0.0.1:55432/goldis
WORKER_DATABASE_URL=postgres://goldis_worker:CHANGE_ME@127.0.0.1:55432/goldis
ENRICHMENT_DATABASE_URL=postgres://goldis_enrichment:CHANGE_ME@127.0.0.1:55432/goldis
DB_PASSWORD=CHANGE_ME
MIGRATOR_DB_PASSWORD=CHANGE_ME
API_DB_PASSWORD=CHANGE_ME
WORKER_DB_PASSWORD=CHANGE_ME
ENRICHMENT_DB_PASSWORD=CHANGE_ME
GOLDIS_POSTGRES_HOST_PORT=55432
GOLDIS_REDIS_HOST_PORT=56379
REDIS_URL=redis://goldis_api:CHANGE_ME@127.0.0.1:56379/0
WORKER_REDIS_URL=redis://goldis_worker:CHANGE_ME@127.0.0.1:56379/0
REDIS_API_PASSWORD=CHANGE_ME
REDIS_WORKER_PASSWORD=CHANGE_ME
API_PORT=3001
API_INTERNAL_URL=http://127.0.0.1:3001
WORKER_INTERNAL_URL=http://127.0.0.1:3022
WORKER_RESULT_API_URL=http://127.0.0.1:3001
PUBLIC_APP_ORIGIN=http://127.0.0.1:3000
# Password recovery remains off locally unless a disposable Resend test setup is configured.
GOLDIS_PASSWORD_RECOVERY_ENABLED=0
GOLDIS_EMAIL_PROVIDER=disabled
GOLDIS_EMAIL_FROM=
GOLDIS_EMAIL_REPLY_TO=
AUTH_MAIL_ENCRYPTION_ACTIVE_KEY_VERSION=1
RESEND_API_KEY=
AUTH_MAIL_ENCRYPTION_KEYS_BASE64=
TRUST_PROXY_IPS=
LOGIN_RATE_LIMIT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
PRIVILEGED_ACTION_BINDING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
GOLDIS_ADMIN_USER=admin-local
GOLDIS_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
PESEL_ENCRYPTION_ACTIVE_KEY_VERSION=1
PESEL_ENCRYPTION_KEYS_BASE64=REPLACE_WITH_BASE64_JSON_KEYRING
ARTIFACT_ENCRYPTION_ACTIVE_KEY_VERSION=1
ARTIFACT_ENCRYPTION_KEYS_BASE64=REPLACE_WITH_DIFFERENT_BASE64_JSON_KEYRING
ARTIFACT_REQUIRE_ENCRYPTION=0
WORKER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
IMPORT_PARSER_URL=http://127.0.0.1:3010
IMPORT_PARSER_HOST=127.0.0.1
IMPORT_PARSER_PORT=3010
IMPORT_PARSER_SHARED_SECRET=REPLACE_WITH_SEPARATE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
WORKER_INTERNAL_HOST=127.0.0.1
WORKER_INTERNAL_PORT=3022
WORKER_HEADLESS=0
WORKER_CHROMIUM_SANDBOX=0
WORKER_BROWSER_CHANNEL=
WORKER_PROFILE_DIR=C:\Users\YourUser\AppData\Local\Goldis\playwright-profile
WORKER_STAGING_DIR=C:\Users\YourUser\AppData\Local\Goldis\staging
WORKER_STAGING_KEY_VERSION=1
WORKER_STAGING_KEY_V1=REPLACE_WITH_BASE64URL_32_BYTE_KEY
API_EXPORT_DIR=C:\Users\YourUser\AppData\Local\Goldis\exports
WORKER_PORTAL_CONFIG_PATH=C:\Users\YourUser\Desktop\Goldis-Automatyzacje\config\portal-selectors.example.json
WORKER_LIVE_PORTALS=0
WORKER_DB_POOL_MAX=8
# Minimum spacing between controlled portal actions on the one owned browser profile (not every page request).
WORKER_PORTAL_MIN_ACTION_INTERVAL_MS=1000
# NIP → REGON uses the free Ministry of Finance VAT register.
GOLDIS_ENRICHMENT_PROVIDER=mf-vat
MF_VAT_ENVIRONMENT=production
MF_VAT_MIN_REQUEST_INTERVAL_MS=1000
# Required by the registry cache. Generate a random 32-byte key as 64 hex characters.
REGISTRY_CACHE_HMAC_KEY=
# Dane portali pozostają puste w trybie off. Nie wpisuj ich do plików przykładowych.
PZU_LOGIN=
PZU_PASSWORD=
COMPENSA_LOGIN=
COMPENSA_PASSWORD=
