{
  "name": "goldis-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @goldis/core && npm run build -w @goldis/api && npm run build -w @goldis/worker && npm run build -w @goldis/web",
    "test": "npm run test:node-test-runner && npm run test:architecture && npm run test:transaction-audit && npm run test:inventory && npm run test:http-contract && npm run test:scenarios && npm run test -w @goldis/core && npm run test -w @goldis/api && npm run test -w @goldis/worker && npm run test:scenario-runtime && npm run test:preflight && npm run test:module:runner && npm run test:backup-crypto && npm run test:backup-manifest && npm run test:runtime-check && npm run test:release-manifest",
    "test:unit": "npm run test:unit -w @goldis/core && npm run test:unit -w @goldis/api && npm run test:unit -w @goldis/worker",
    "test:http": "npm run test:http -w @goldis/api",
    "test:contract": "npm run test:contract -w @goldis/api",
    "test:integration": "npm run test:db-integration",
    "test:e2e:fixture": "npm run test:module:security-browser && npm run test:module:everest-browser && npm run test:module:compensa-browser && npm run test:module:ufg-browser",
    "test:node-test-runner": "node --test scripts/run-node-tests.test.cjs",
    "lint:backend": "biome lint apps/api/src/features",
    "format:backend:check": "biome format apps/api/src/features",
    "format:backend": "biome format --write apps/api/src/features",
    "check:backend:style": "biome check apps/api/src/features",
    "test:architecture": "node scripts/check-feature-boundaries.cjs && node --test scripts/check-feature-boundaries.test.cjs",
    "test:transaction-audit": "node scripts/backend-refactor-transaction-audit.cjs && node --test scripts/backend-refactor-transaction-audit.test.cjs",
    "test:inventory": "node --test scripts/backend-refactor-inventory.test.cjs",
    "test:http-contract": "node --test scripts/backend-refactor-http-contract.test.cjs && node scripts/check-legacy-http-contract.cjs",
    "test:scenarios": "node --test scripts/backend-refactor-scenarios.test.cjs",
    "test:scenario-runtime": "node --test scripts/backend-refactor-runtime-scenarios.test.cjs",
    "test:scenario-runtime:build": "npm run build -w @goldis/api && npm run build -w @goldis/worker && npm run test:scenario-runtime",
    "backend:refactor:inventory": "node scripts/backend-refactor-inventory.cjs --write",
    "backend:refactor:scenarios": "node scripts/backend-refactor-scenarios.cjs --write",
    "backend:refactor:runtime-scenarios": "npm run build -w @goldis/api && npm run build -w @goldis/worker && node scripts/backend-refactor-runtime-scenarios.cjs --write",
    "backend:refactor:import-effects": "node scripts/backend-refactor-import-effects.cjs --write",
    "test:preflight": "node --test scripts/preflight-contract.test.cjs",
    "test:module:runner": "node --test scripts/test-module.test.cjs",
    "test:module:migrations": "node scripts/test-module.cjs migrations",
    "test:module:migrations-upgrade": "node scripts/test-module.cjs migrations-upgrade",
    "test:module:password-recovery": "node scripts/test-module.cjs password-recovery",
    "test:module:tenant-scope": "node scripts/test-module.cjs tenant-scope",
    "test:backup-crypto": "node --test scripts/goldis-backup-crypto.test.cjs",
    "test:backup-manifest": "node --test deploy/backup/manifest.test.cjs",
    "test:runtime-check": "node --test scripts/runtime-check.test.cjs",
    "test:release-manifest": "node --test scripts/create-release-manifest.test.cjs",
    "release:manifest": "node scripts/create-release-manifest.cjs",
    "test:module:backup-restore": "npm run test:backup-crypto && node scripts/test-module.cjs backup-restore",
    "test:module:grouping": "node scripts/test-module.cjs grouping",
    "test:module:registry": "node scripts/test-module.cjs registry",
    "test:module:registry-jobs": "node scripts/test-module.cjs registry-jobs",
    "test:module:reports": "node scripts/test-module.cjs reports",
    "test:module:runtime": "node scripts/test-module.cjs runtime",
    "test:module:database": "node scripts/test-module.cjs database",
    "test:module:health": "node scripts/test-module.cjs health",
    "test:module:review": "node scripts/test-module.cjs review",
    "test:module:leads": "node scripts/test-module.cjs leads",
    "test:module:submission": "node scripts/test-module.cjs submission",
    "test:module:teams": "node scripts/test-module.cjs teams",
    "test:module:tools": "node scripts/test-module.cjs tools",
    "test:module:admin": "node scripts/test-module.cjs admin",
    "test:module:teams-db": "node scripts/test-module.cjs teams-db",
    "test:module:admin-users-db": "node scripts/test-module.cjs admin-users-db",
    "test:module:auth": "node scripts/test-module.cjs auth",
    "test:module:security": "node scripts/test-module.cjs security",
    "test:module:security-db": "node scripts/test-module.cjs security-db",
    "test:module:runtime-roles": "node scripts/test-module.cjs runtime-roles",
    "test:module:app-module": "node scripts/test-module.cjs app-module",
    "test:module:deletion": "node scripts/test-module.cjs deletion",
    "test:module:deletion-jobs": "node scripts/test-module.cjs deletion-jobs",
    "test:module:worker-lifecycle": "node scripts/test-module.cjs worker-lifecycle",
    "test:module:run-control": "node scripts/test-module.cjs run-control",
    "test:module:runs": "node scripts/test-module.cjs runs",
    "test:module:interventions": "node scripts/test-module.cjs interventions",
    "test:module:notifications": "node scripts/test-module.cjs notifications",
    "test:module:deletion-step-up": "node scripts/test-module.cjs deletion-step-up",
    "test:module:security-redis": "node scripts/test-module.cjs security-redis",
    "test:module:security-browser": "npm run build -w @goldis/web && node apps/web/scripts/security-browser-smoke.cjs",
    "test:module:sms": "node scripts/test-module.cjs sms",
    "test:module:results": "node scripts/test-module.cjs results",
    "test:module:audit-reports": "node scripts/test-module.cjs audit-reports",
    "test:module:everest": "node scripts/test-module.cjs everest",
    "test:module:everest-browser": "node scripts/test-module.cjs everest-browser",
    "test:module:compensa": "node scripts/test-module.cjs compensa",
    "test:module:compensa-browser": "node scripts/test-module.cjs compensa-browser",
    "test:module:ufg": "node scripts/test-module.cjs ufg",
    "test:module:ufg-browser": "node scripts/test-module.cjs ufg-browser",
    "test:compensa-happy-flow": "npm run build -w @goldis/worker && npm run build -w @goldis/api && node --test scripts/compensa-happy-flow.test.cjs",
    "test:db-integration": "node apps/api/scripts/run-db-integration.cjs",
    "test:automation-e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test-GoldisDatabase.ps1 -Automation",
    "test:platform-e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test-GoldisDatabase.ps1 -Automation -PlatformOnly",
    "dev:web": "npm run dev -w @goldis/web",
    "dev:api": "npm run dev -w @goldis/api",
    "dev:worker": "npm run dev -w @goldis/worker",
    "preflight:local": "node scripts/local-preflight.cjs",
    "validate:production-compose": "node scripts/validate-production-compose.cjs",
    "test:production-compose": "node scripts/test-production-compose.cjs",
    "setup:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Initialize-GoldisLocal.ps1",
    "upgrade:local:db-roles": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Upgrade-GoldisLocalDatabaseRoles.ps1",
    "start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Start-GoldisLocal.ps1",
    "restore:deletion-journal": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Apply-GoldisDeletionJournal.ps1"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
