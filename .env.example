PZU_LOGIN_URL=https://everest.pzu.pl/pc/PolicyCenter.do
PZU_LOGIN=login_do_pzu
PZU_PASSWORD=hasło_do_pzu

COMPENSA_LOGIN_URL=https://cportal.compensa.pl/Portal#/
COMPENSA_LOGIN=login_do_compensa    
COMPENSA_PASSWORD=hasło_do_compensa
APP_ENV=development
GOLDIS_SECRETS_DIR=./.goldis-secrets
DB_PASSWORD=
MIGRATOR_DB_PASSWORD=
API_DB_PASSWORD=
WORKER_DB_PASSWORD=
ENRICHMENT_DB_PASSWORD=
DATABASE_URL=postgres://goldis_api:CHANGE_ME@127.0.0.1:5432/goldis
MIGRATOR_DATABASE_URL=postgres://goldis_migrator:CHANGE_ME@127.0.0.1:5432/goldis
WORKER_DATABASE_URL=postgres://goldis_worker:CHANGE_ME@127.0.0.1:5432/goldis
ENRICHMENT_DATABASE_URL=postgres://goldis_enrichment:CHANGE_ME@127.0.0.1:5432/goldis
REDIS_URL=redis://goldis_api:CHANGE_ME@127.0.0.1:6379/0
WORKER_REDIS_URL=redis://goldis_worker:CHANGE_ME@127.0.0.1:6379/0
REDIS_API_PASSWORD=
REDIS_WORKER_PASSWORD=
SESSION_SECRET=
PUBLIC_APP_ORIGIN=http://localhost:3000
# Password recovery stays off until the Resend domain, sender, and account emails are ready.
GOLDIS_PASSWORD_RECOVERY_ENABLED=0
GOLDIS_EMAIL_PROVIDER=disabled
GOLDIS_EMAIL_FROM=
GOLDIS_EMAIL_REPLY_TO=
AUTH_MAIL_ENCRYPTION_ACTIVE_KEY_VERSION=1
RESEND_API_KEY=
AUTH_MAIL_ENCRYPTION_KEYS_BASE64=
# Comma-separated exact IP addresses of trusted reverse proxies. Leave empty for direct access.
TRUST_PROXY_IPS=
LOGIN_RATE_LIMIT_SECRET=
PRIVILEGED_ACTION_BINDING_KEY=
GOLDIS_ADMIN_USER=
GOLDIS_ADMIN_PASSWORD=
# AES-256 keyring: base64-encoded JSON object whose version keys map to base64-encoded 32-byte keys.
PESEL_ENCRYPTION_ACTIVE_KEY_VERSION=
PESEL_ENCRYPTION_KEYS_BASE64=
ARTIFACT_ENCRYPTION_ACTIVE_KEY_VERSION=
ARTIFACT_ENCRYPTION_KEYS_BASE64=
ARTIFACT_REQUIRE_ENCRYPTION=0
WORKER_AUTH_SECRET=
# Internal API-to-parser URL. The parser is reachable only on the private parser network.
IMPORT_PARSER_URL=http://127.0.0.1:3010
IMPORT_PARSER_HOST=127.0.0.1
IMPORT_PARSER_PORT=3010
IMPORT_PARSER_SHARED_SECRET=
# API-to-worker URL for local Windows processes; Compose overrides it with http://worker:3022.
WORKER_INTERNAL_URL=http://127.0.0.1:3022
WORKER_INTERNAL_HOST=127.0.0.1
WORKER_INTERNAL_PORT=3022
# Local visible Playwright worker: 0 for a browser window, 1 for headless container mode.
WORKER_HEADLESS=1
# Enabled by the production container; local Windows browser sessions may leave this at 0.
WORKER_CHROMIUM_SANDBOX=0
# Optional: chrome or msedge; omit to use Playwright's bundled Chromium.
WORKER_BROWSER_CHANNEL=
WORKER_PROFILE_DIR=
WORKER_PORTAL_CONFIG_PATH=C:\Users\YourUser\Desktop\Goldis-Automatyzacje\config\portal-selectors.example.json
API_EXPORT_DIR=C:\Users\YourUser\AppData\Local\Goldis\exports
WORKER_RESULT_API_URL=http://127.0.0.1:3001
# Absolute path to a JSON file with verified portal selectors (no credentials).
# Container path is fixed by compose.yaml; host path selects a local, reviewed JSON file.
WORKER_PORTAL_CONFIG_PATH_HOST=./config/portal-selectors.example.json
WORKER_LIVE_PORTALS=0
WORKER_DB_POOL_MAX=8
# Minimum spacing between controlled portal actions on the one owned browser profile (not every page request).
WORKER_PORTAL_MIN_ACTION_INTERVAL_MS=1000
# NIP → REGON uses the free Ministry of Finance VAT register.
GOLDIS_ENRICHMENT_PROVIDER=mf-vat
MF_VAT_ENVIRONMENT=production
MF_VAT_MIN_REQUEST_INTERVAL_MS=1000
# Required by the registry cache. Generate a random 32-byte key as 64 hex characters.
REGISTRY_CACHE_HMAC_KEY=
# Staging key versions are positive integers; key material is a 32-byte base64url value.
# Required when portal automation is enabled. Generate random keys outside source control.
WORKER_STAGING_DIR=
WORKER_STAGING_KEY_VERSION=
WORKER_STAGING_KEY_V1=
