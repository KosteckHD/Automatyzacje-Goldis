{
  "name": "@goldis/worker",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "clean": "node ../../scripts/clean-workspace-dist.cjs @goldis/worker",
    "build": "npm run build -w @goldis/core && npm run clean && tsc -p tsconfig.json",
    "dev": "npm run build && node dist/run-worker.js",
    "start": "node dist/run-worker.js",
    "test": "npm run build && node ../../scripts/run-node-tests.cjs dist",
    "test:unit": "npm run build && node ../../scripts/run-node-tests.cjs dist unit",
    "test:playwright": "npm run build && node scripts/test-playwright.cjs"
  },
  "dependencies": {
    "@goldis/core": "0.1.0",
    "bullmq": "^5.81.5",
    "pg": "^8.23.0",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.0"
  }
}
